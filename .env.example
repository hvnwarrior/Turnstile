# SQLite database location
TURNSTILE_DATABASE_PATH=data/turnstile.db

# Append-only audit log location
TURNSTILE_AUDIT_LOG_PATH=data/audit.jsonl

# HRIS webhook HMAC secret (required for signed webhooks)
TURNSTILE_HRIS_WEBHOOK_SECRET=

# Reject unsigned HRIS webhooks (fail closed). Set false ONLY for local dev.
TURNSTILE_HRIS_REQUIRE_SIGNATURE=true

# LLM advisor (next milestone)
TURNSTILE_ANTHROPIC_API_KEY=

# Handle substituted for the "it_admin" assignee role on gated tasks
TURNSTILE_DEFAULT_APPROVER=it-admin

# Assign gated tasks that resolve to no assignee (e.g. manager missing
# from intake) to this handle instead of refusing the build.
# Leave EMPTY to keep the fail-closed refusal.
TURNSTILE_FALLBACK_APPROVER=
